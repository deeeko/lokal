# Optional. Everything works without these.
# ANTHROPIC_API_KEY=            # enables free-form requests ("pay Ada ten dollars"); never commit this
# ANTHROPIC_MODEL=claude-sonnet-5-5
# MAX_USD=25                    # per-payout cap
# MAX_SLIPPAGE_BPS=300          # abort if the firm quote is >3% worse than the preview
# ATTRIBUTION_CODE=celo_7360953d1b53
# MAX_DAILY_USD=100             # cap on USD paid out in any rolling 24 h (from receipts.jsonl)
# REQUESTS_FILE=requests.json   # payment requests (git-ignored)
# WATCH_STATE_FILE=watch-state.json  # autopilot block cursor (git-ignored)
# MAX_WALLET_DAILY_USD=25       # "Get paid": cap on USD paid to any one wallet in a rolling 24 h
# REGISTRATIONS_STATE_FILE=registrations-state.json  # "Get paid" deposits and payouts (git-ignored)
# BLOCKSCOUT_API=https://celo.blockscout.com/api/v2  # where "Get paid" registrations are discovered
# MIN_CELO_RESERVE=2            # celo-cngn: CELO the agent wallet must keep after selling (gas for every later tx)
# CELO_GAS_MARGIN=0.1           # celo-cngn: CELO set aside for the up-to-7 transactions of one payout
# REFUNDS_FILE=refunds.json     # refunds of deposits autopilot never pays (git-ignored)
# MAX_DAILY_REFUND_USD=100      # cap on USD refunded in any rolling 24 h (refunds never count towards the payout caps)
# MIN_REFUND_USD=1              # deposits worth less are recorded as too_small_to_refund and left alone
# AGENT_LOCK_FILE=agent.lock    # one agent at a time: watch --execute and every --execute command take it
# LOW_CELO_WARN=3               # autopilot warns (and alerts) when the agent holds less CELO than this
#
# Alerts (optional). Sent for: autopilot stopped, payout or refund failed (urgent); daily cap reached, CELO low, status
# server unreachable 10+ minutes (warning); deposit refused, payout paid (info). They never contain keys or secrets,
# wait in an outbox and are sent in the background (5 s timeout), so a failing alert never stops or changes a payout.
# Test with: node src/agent.mjs alert-test
# ALERT_TELEGRAM_TOKEN=         # a Telegram bot token from @BotFather (a secret: never commit it)
# ALERT_TELEGRAM_CHAT_ID=       # the chat the bot posts to (your user id, or a group id)
# ALERT_WEBHOOK_URL=            # any https URL taking a JSON POST { text, content, level, kind, at } (Slack, Discord, ...)
# ALERT_MUTE=payout_paid        # comma-separated info alerts to mute: payout_paid, deposit_refused
# ALERTS_OUTBOX_FILE=alerts-outbox.jsonl  # alerts waiting to be sent (git-ignored)
